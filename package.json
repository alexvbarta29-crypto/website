{
  "name": "barta-window-washing-site",
  "private": true,
  "type": "module",
  "description": "Barta Window Washing referral app: Netlify Functions for /api/referral, /api/referral/admin and /api/claim (see README.md).",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:crm": "node --test \"tests/crm/**/*.test.mjs\"",
    "scan": "node build/no_data_scan.mjs",
    "prepare": "node -e \"try{const{spawnSync:r}=require('node:child_process');const o={stdio:'ignore'};const g=r('git',['rev-parse','--is-inside-work-tree'],o);if(g.status===0)r('git',['config','core.hooksPath','.githooks'],o)}catch(e){}\" || exit 0"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.2"
  }
}
